{
 "schema": "astor-legacy-editorial-beat-v2.1",
 "required": [
  "beat_id",
  "start_time",
  "end_time",
  "start_word",
  "end_word",
  "semantic_role",
  "claim",
  "visual_verb",
  "focal_object",
  "duration_class",
  "intensity",
  "music_intensity",
  "sfx_policy",
  "events",
  "visual_mode",
  "visual_reason"
 ],
 "events_schema": "VO_EVENT_ALIGNMENT_SCHEMA.json",
 "semantic_role_enum": [
  "hook",
  "claim",
  "contrast",
  "number",
  "cause",
  "effect",
  "example",
  "question",
  "answer",
  "metaphor",
  "escalation",
  "payoff",
  "transition",
  "close",
  "trend",
  "comparison"
 ],
 "visual_verb_enum": [
  "build",
  "count",
  "rise",
  "fall",
  "compare",
  "split",
  "connect",
  "collide",
  "reveal",
  "accumulate",
  "lock",
  "freeze",
  "transform",
  "zoom",
  "track",
  "highlight",
  "swap"
 ],
 "duration_class_enum": [
  "micro",
  "normal",
  "complex",
  "hero"
 ],
 "sfx_policy_enum": [
  "none",
  "candidate",
  "required"
 ],
 "visual_mode_enum": [
  "hero_typography",
  "hero_number",
  "line_chart",
  "area_chart",
  "bar_chart",
  "comparison_bars",
  "donut_allocation",
  "metric_grid",
  "dashboard",
  "portfolio_card_stack",
  "ranked_table",
  "glass_notification",
  "feature_icon_system",
  "before_after",
  "two_sided_comparison",
  "causal_diagram",
  "causal_loop",
  "timeline",
  "flow_diagram",
  "real_world_financial_imagery",
  "imagery_plus_glass_overlay",
  "thesis_composition",
  "closing_composition"
 ],
 "visual_fields": {
  "visual_mode": "REQUIRED \u2014 one of visual_mode_enum. A beat with no visual_mode FAILS the contract (headline-only fallback is not silent).",
  "visual_reason": "REQUIRED \u2014 one sentence: why this mode is the clearest premium explanation of the claim.",
  "data_presence": "boolean \u2014 does the narration contain measurable data?",
  "data_type": "one of: statistic|trend|ranking|allocation|comparison|timeline|mechanism|none",
  "comparison_state": "one of: none|A_vs_B|before_after|ranked (when applicable)",
  "data_payload_ref": "reference to the structured data payload (see crackit/VISUAL_DATA_CONTRACT.md) or null when data_presence is false. Charts/tables/dashboards REQUIRE a payload ref \u2014 never invent values."
 },
 "timing_law": {
  "micro_max_s": 1.3,
  "normal_max_s": 2.8,
  "complex_max_s": 4.5,
  "complex_internal_change_max_s": 1.5,
  "absolute_hold_max_s": 4.5,
  "major_reset_min_s": 6,
  "major_reset_max_s": 9
 },
 "alignment_law": {
  "word_timestamps_primary": true,
  "major_claim_max_ms": 300,
  "punch_word_max_frames": 2,
  "late_payoff_forbidden": true
 }
}